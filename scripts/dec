#!/usr/bin/env bash
# =============================================================================
#  dec  v5.2 — decrypt files created by enc v5.2
#  Usage : dec <file.vault | file[.tar][.<comp>].<age|gpg>>
#
#  MEMORY SAFETY:
#    All intermediate data lives exclusively in /dev/shm (RAM-backed tmpfs).
#    Nothing touches /tmp or any disk path during processing.
#    Temp dir is shredded (zeroed) before removal on exit, interrupt, or error.
#    Decryption streams:  openssl -d | decompress | tar -x  in one pipeline
#    — no intermediate decrypted or decompressed file written to shm.
#    The only shm content is the staging directory for extracted files,
#    which is moved to CWD immediately and then shredded.
#    Hard limit: aborts if vault payload exceeds 100 MiB.
#
#  SECURITY MODEL:
#    HMAC verified over (all header fields || ciphertext) BEFORE any decryption.
#    ORIG sanitized to basename only — no ../ traversal.
#    Tar pre-scanned for dangerous paths before extraction.
#    Output always placed in CWD regardless of archive contents.
# =============================================================================

set -uo pipefail

# ── Catppuccin Mocha ──────────────────────────────────────────────────────────
RED='\033[38;2;243;139;168m';    GREEN='\033[38;2;166;227;161m'
YELLOW='\033[38;2;249;226;175m'; BLUE='\033[38;2;137;180;250m'
MAUVE='\033[38;2;203;166;247m';  PEACH='\033[38;2;250;179;135m'
TEAL='\033[38;2;148;226;213m';   LAVENDER='\033[38;2;180;190;254m'
SAPPHIRE='\033[38;2;116;199;236m'
TEXT='\033[38;2;205;214;244m';   SUBTEXT='\033[38;2;166;173;200m'
BOLD='\033[1m'; DIM='\033[2m'; NC='\033[0m'

ok()   { echo -e "${GREEN}  ✓  ${*}${NC}"; }
err()  { echo -e "${RED}  ✗  ${*}${NC}" >&2; }
warn() { echo -e "${YELLOW}  ⚠  ${*}${NC}"; }
info() { echo -e "${TEAL}  →  ${*}${NC}"; }
step() { echo -e "\n${MAUVE}${BOLD}  ══  ${*}${NC}"; }
lbl()  { echo -e "${SUBTEXT}  ${1}${TEXT}${2:-}${NC}"; }
sep()  { echo -e "${SUBTEXT}${DIM}  ──────────────────────────────────────────${NC}"; }

banner() {
  local target="$1" mode="$2"
  local disp="$target"
  (( ${#disp} > 44 )) && disp="…${target: -43}"
  local inner="  vault ${mode}  v5.2  ·  ${disp}  "
  local w=${#inner} bar="" i
  for (( i=0; i<w; i++ )); do bar+="═"; done
  echo
  echo -e "${MAUVE}${BOLD}  ╔${bar}╗${NC}"
  echo -e "${MAUVE}${BOLD}  ║${inner}║${NC}"
  echo -e "${MAUVE}${BOLD}  ╚${bar}╝${NC}"
  echo
}

sep_hdr() {
  local s_lbl="$1" line="" fill i
  fill=$(( 68 - ${#s_lbl} - 6 ))
  for (( i=0; i<fill; i++ )); do line+="─"; done
  echo -e "\n  ${SUBTEXT}${DIM}──  ${NC}${LAVENDER}${BOLD}${s_lbl}${NC}  ${SUBTEXT}${DIM}${line}${NC}\n"
}

need() { command -v "$1" &>/dev/null || { err "'$1' not installed.  $2"; exit 1; }; }

# ── /dev/shm guard ────────────────────────────────────────────────────────────
check_shm() {
  [[ -d /dev/shm && -w /dev/shm ]] || {
    err "/dev/shm unavailable — cannot create in-memory workspace"
    exit 1
  }
}

# ── Sanitize filename ─────────────────────────────────────────────────────────
sanitize_name() {
  local raw="$1"
  raw="${raw//$'\0'/}"
  raw="$(basename "$raw")"
  [[ -z "$raw" || "$raw" == "." || "$raw" == ".." ]] && {
    err "Unsafe filename in vault header: '${1}'"
    err "This vault may be crafted to overwrite system files — aborting."
    exit 1
  }
  [[ "$raw" == */* || "$raw" == *\\* ]] && {
    err "Filename contains path separator — aborting."; exit 1; }
  printf '%s' "$raw"
}

# ── Pre-scan tar for dangerous entries ───────────────────────────────────────
check_tar_safety() {
  local archive="$1"
  local paths
  paths=$(tar -tf "$archive" 2>/dev/null) || {
    err "Cannot list archive entries — may be corrupted"; exit 1; }
  # Catch: absolute paths, ../ in middle, trailing .., bare ..
  local dangerous
  dangerous=$(printf '%s\n' "$paths" | grep -E '(^|/)\.\.(/|$)|(^/)' || true)
  if [[ -n "$dangerous" ]]; then
    echo
    err "Archive contains dangerous paths — REFUSING to extract:"
    printf '%s\n' "$dangerous" | head -10 | while IFS= read -r p; do
      echo -e "    ${RED}  ${p}${NC}" >&2; done
    err "Vault was likely crafted to overwrite critical files."; exit 1
  fi
  # Only warn for symlinks pointing to absolute paths or parent dirs
  local dsym
  dsym=$(tar -tvf "$archive" 2>/dev/null | grep '^l' \
    | sed 's/.* -> //' | grep -E '^(/|\.\.)' || true)
  [[ -n "$dsym" ]] && warn "Archive contains symlinks targeting absolute/parent paths."
  local n; n=$(printf '%s\n' "$paths" | wc -l)
  if (( n > 10000 )); then
    warn "Archive has ${n} entries — unusually large."
    printf "${PEACH}  Continue? [y/N]  ${NC}"; read -r ans
    [[ "$ans" =~ ^[yY]$ ]] || { err "Aborted."; exit 1; }
  fi
}

# ── Post-extraction safety scan ───────────────────────────────────────────────
# Called on STAGE dir after streaming extraction.
# GNU tar strips leading / by default. We check for symlinks that escaped
# staging by pointing to absolute paths or ../ parents.
scan_stage_safety() {
  local stage="$1" issues=0
  # Dangerous symlinks: targets that are absolute or use ../
  while IFS= read -r -d '' lnk; do
    local target
    target=$(readlink "$lnk")
    if [[ "$target" == /* || "$target" == ../* || "$target" == */../* ]]; then
      err "Dangerous symlink in extracted archive: $lnk -> $target"
      (( issues++ )) || true
    fi
  done < <(find "$stage" -type l -print0 2>/dev/null)

  if (( issues > 0 )); then
    err "Archive contained ${issues} dangerous symlink(s) — shredding staging dir."
    find "$stage" -type f -exec shred -uz {} \; 2>/dev/null || true
    rm -rf "$stage"
    exit 1
  fi
}

# ── Shred all files in SHM_TMP, then remove ───────────────────────────────────
SHM_TMP=""
cleanup() {
  [[ -z "$SHM_TMP" || ! -d "$SHM_TMP" ]] && return
  find "$SHM_TMP" -type f -exec shred -uz {} \; 2>/dev/null || true
  rm -rf "$SHM_TMP"
}
trap cleanup EXIT INT TERM

# ── Argon2id KDF ──────────────────────────────────────────────────────────────
derive_key() {
  local passwd="$1" salt="$2" t="$3" m="$4" p="$5"
  RAW_KEY=$(printf '%s' "$passwd" \
    | argon2 "$salt" -id -t "$t" -m "$m" -p "$p" -l 64 -r 2>/dev/null \
    | tr -d '[:space:]')
  [[ ${#RAW_KEY} -eq 128 ]] || {
    err "Argon2id failed  (install: sudo pacman -S argon2)"; exit 1; }
}

# ── Pre-scan vault tar payload for path traversal ────────────────────────────
# Runs a dry-run decrypt+decompress|tar -tf - before actual extraction.
# For streaming vaults: reads payload from INPUT twice (no temp file written).
# Sets global PRESCAN_PATHS for the caller to inspect.
prescan_tar() {
  local pipeline_out
  pipeline_out="$1"   # command string that emits the decompressed tar stream
  local paths dangerous
  paths=$(eval "$pipeline_out" | tar -tf - 2>/dev/null) || {
    err "Tar listing failed — vault may be corrupted or password wrong"; exit 1; }
  dangerous=$(printf '%s
' "$paths" | grep -E '(^|/)\.\.(/|$)|(^/)' || true)
  if [[ -n "$dangerous" ]]; then
    echo
    err "Archive contains dangerous paths — REFUSING to extract:"
    printf '%s
' "$dangerous" | head -10 | while IFS= read -r p; do
      echo -e "    ${RED}  ${p}${NC}" >&2; done
    err "Vault was likely crafted to overwrite critical files."; exit 1
  fi
  local n; n=$(printf '%s
' "$paths" | wc -l)
  if (( n > 10000 )); then
    warn "Archive has ${n} entries — unusually large."
    printf "${PEACH}  Continue? [y/N]  ${NC}"; read -r ans
    [[ "$ans" =~ ^[yY]$ ]] || { err "Aborted."; exit 1; }
  fi
}

# =============================================================================
main() {
  need tar     "sudo pacman -S tar"
  need dd      "coreutils"
  need openssl "sudo pacman -S openssl"
  need shred   "sudo pacman -S coreutils"
  check_shm

  [[ $# -lt 1 ]] && {
    err "Usage: dec <file.vault | file[.tar][.<ext>].<age|gpg>>"; exit 1; }

  INPUT="$1"
  [[ ! -f "$INPUT" ]] && { err "File not found: $INPUT"; exit 1; }
  INPUT="$(realpath "$INPUT")"

  banner "$(basename "$INPUT")" "dec"

  # ── Detect method from extension ──────────────────────────────────────────
  case "$INPUT" in
    *.vault)     METHOD="vault" ;;
    *.age)       METHOD="age"   ;;
    *.gpg|*.pgp) METHOD="gpg"   ;;
    *)
      err "Unknown extension: $(basename "$INPUT")"
      err "Expected: .vault | [.tar][.<comp>].age | [.tar][.<comp>].gpg"
      exit 1 ;;
  esac

  # ── Init metadata ──────────────────────────────────────────────────────────
  ALGO=""; LABEL=""; AUTH="no"; COMP=""; FTYPE=""; ORIG_NAME=""
  HAS_TAR=true; KDF_SALT=""; KDF_T=3; KDF_M=14; KDF_P=4; KEY_LEN=64
  IV=""; STORED_HMAC=""; INTEGRITY=""; HDR_LEN=0; HDR=""

  # ── Vault: parse header ────────────────────────────────────────────────────
  if [[ "$METHOD" == "vault" ]]; then
    HDR_HEX=$(dd if="$INPUT" bs=1 count=8 2>/dev/null)
    [[ "$HDR_HEX" =~ ^[0-9a-fA-F]{8}$ ]] || {
      err "Not a valid vault file (bad magic: '${HDR_HEX}')"; exit 1; }
    HDR_LEN=$(( 16#$HDR_HEX ))
    (( HDR_LEN > 0 && HDR_LEN <= 8192 )) || {
      err "Header length implausible: ${HDR_LEN}"; exit 1; }
    HDR=$(dd if="$INPUT" bs=1 skip=8 count="$HDR_LEN" 2>/dev/null)
    VERSION=$(printf '%s\n' "$HDR" | head -n1)
    [[ "$VERSION" == "VAULTV1" ]] || {
      err "Unsupported vault version: '${VERSION}'"; exit 1; }

    _hf() { printf '%s\n' "$HDR" | grep -m1 "^${1}=" | cut -d= -f2-; }
    LABEL="$(_hf LABEL)"; ALGO="$(_hf ALGO)";  AUTH="$(_hf AUTH)"
    COMP="$(_hf COMP)";   FTYPE="$(_hf TYPE)"; ORIG_NAME="$(_hf ORIG)"
    TAR_F="$(_hf TAR)";   [[ "$TAR_F" == "false" ]] && HAS_TAR=false || HAS_TAR=true

    if [[ "$ALGO" != "none" ]]; then
      KDF_SALT="$(_hf KDF_SALT)"; KDF_T="$(_hf KDF_T)"; KDF_M="$(_hf KDF_M)"
      KDF_P="$(_hf KDF_P)"; KEY_LEN="$(_hf KEY_LEN)"; IV="$(_hf IV)"
      STORED_HMAC="$(_hf HMAC)"
      [[ -z "$ALGO" || -z "$KDF_SALT" || -z "$IV" ]] && {
        err "Vault header missing required fields (ALGO / KDF_SALT / IV)"; exit 1; }
    else
      INTEGRITY="$(_hf INTEGRITY)"; LABEL="${LABEL:-none}"
    fi
    [[ -z "$ORIG_NAME" ]] && { err "Vault header missing ORIG field"; exit 1; }
  fi

  # ── age/gpg: infer from filename ───────────────────────────────────────────
  if [[ "$METHOD" == "age" || "$METHOD" == "gpg" ]]; then
    need "$METHOD" "sudo pacman -S $([ "$METHOD" = age ] && echo age || echo gnupg)"
    INNER="${INPUT%.*}"
    case "$INNER" in
      *.tar.gz)   COMP="gzip";   HAS_TAR=true ;;
      *.tar.bz2)  COMP="bzip2";  HAS_TAR=true ;;
      *.tar.xz)   COMP="xz";     HAS_TAR=true ;;
      *.tar.zst)  COMP="zstd";   HAS_TAR=true ;;
      *.tar.lz4)  COMP="lz4";    HAS_TAR=true ;;
      *.tar.br)   COMP="brotli"; HAS_TAR=true ;;
      *.tar.lzo)  COMP="lzo";    HAS_TAR=true ;;
      *.tar.7z)   COMP="7z";     HAS_TAR=true ;;
      *.tar.zlib) COMP="zlib";   HAS_TAR=true ;;
      *.tar)      COMP="none";   HAS_TAR=true ;;
      *)          COMP="none";   HAS_TAR=false ;;
    esac
    ALGO="$METHOD"; AUTH="yes"; LABEL="$METHOD"
    ORIG_NAME="$(basename "${INNER%.tar*}")"
    [[ "$HAS_TAR" == false ]] && ORIG_NAME="$(basename "$INNER")"
  fi

  ORIG_NAME="$(sanitize_name "$ORIG_NAME")"

  case "$COMP" in
    gzip)   need gunzip  "sudo pacman -S gzip"   ;;
    bzip2)  need bunzip2 "sudo pacman -S bzip2"  ;;
    xz)     need unxz    "sudo pacman -S xz"     ;;
    zstd)   need zstd    "sudo pacman -S zstd"   ;;
    lz4)    need lz4     "sudo pacman -S lz4"    ;;
    brotli) need brotli  "sudo pacman -S brotli" ;;
    lzo)    need lzop    "sudo pacman -S lzop"   ;;
    7z)     need 7z      "sudo pacman -S p7zip"  ;;
    zlib)   need python3 "sudo pacman -S python" ;;
  esac

  # ── Payload size check (100 MiB limit) ────────────────────────────────────
  VAULT_SIZE=$(stat -c%s "$INPUT" 2>/dev/null || echo 0)
  PAYLOAD_BYTES=$(( VAULT_SIZE - 8 - HDR_LEN ))
  SHM_LIMIT=$(( 100 * 1024 * 1024 ))
  if (( PAYLOAD_BYTES > SHM_LIMIT )); then
    err "Vault payload is $(( PAYLOAD_BYTES / 1024 / 1024 )) MiB — exceeds 100 MiB limit."
    err "This vault was created with a file larger than the memory budget allows."
    exit 1
  fi
  SHM_FREE=$(( $(df --output=avail /dev/shm | tail -1) * 1024 ))
  (( PAYLOAD_BYTES > SHM_FREE )) && {
    err "Not enough /dev/shm space for payload (need ~$(( PAYLOAD_BYTES / 1024 / 1024 )) MiB)"
    exit 1
  }

  # ── File details — shown BEFORE password ──────────────────────────────────
  sep_hdr "File details"
  lbl "  file      :  " "$(basename "$INPUT")  ($(du -sh "$INPUT" | cut -f1))"
  lbl "  method    :  " "$METHOD"
  lbl "  cipher    :  " "${LABEL:-$ALGO}"
  lbl "  auth      :  " "$AUTH"
  lbl "  compress  :  " "${COMP:-unknown}"
  lbl "  tar wrap  :  " "$HAS_TAR"
  lbl "  original  :  " "$ORIG_NAME"
  [[ -n "$FTYPE" ]] && lbl "  type      :  " "$FTYPE"
  if [[ "$AUTH" == "yes" && "$METHOD" == "vault" && -n "$STORED_HMAC" ]]; then
    lbl "  HMAC      :  " "${STORED_HMAC:0:16}…  (covers all header fields + ciphertext)"
  fi
  echo
  warn "Only decrypt files from sources you trust."
  warn "Output will land in: ${BOLD}$(pwd)${NC}"

  if [[ "${ALGO:-x}" == "none" ]]; then
    echo; warn "This vault was created WITHOUT encryption — data is plain."
    printf "${PEACH}  Continue? [y/N]  ${NC}"; read -r ans
    [[ "$ans" =~ ^[yY]$ ]] || { info "Aborted."; exit 0; }
  fi
  sep; echo

  # ── Password ───────────────────────────────────────────────────────────────
  PASSWD=""
  if [[ "$METHOD" != "age" && "${ALGO:-x}" != "none" ]]; then
    sep_hdr "Password"
    printf "  ${LAVENDER}${BOLD}Password :  ${NC}"; read -rs PASSWD; echo
    [[ -z "$PASSWD" ]] && { err "Password cannot be empty"; exit 1; }
    echo
  elif [[ "$METHOD" == "age" ]]; then
    info "age will prompt for passphrase during decryption"; echo
  fi

  # ── HMAC pre-verification (before any decryption attempt) ─────────────────
  ENC_KEY=""; HMAC_KEY=""

  if [[ "$METHOD" == "vault" && "$ALGO" != "none" && "$AUTH" == "yes" ]]; then
    need argon2 "sudo pacman -S argon2"

    info "Argon2id re-derive  (t=${KDF_T}, m=2^${KDF_M} KiB, p=${KDF_P}) ..."
    derive_key "$PASSWD" "$KDF_SALT" "$KDF_T" "$KDF_M" "$KDF_P"
    # RAW_KEY hex [0-63]   = cipher key  (bytes 0-31, or 0-15 for 128-bit)
    # RAW_KEY hex [64-127] = HMAC key    (hex offset 64 = byte offset 32, 32 bytes)
    ENC_KEY="${RAW_KEY:0:$KEY_LEN}"
    HMAC_KEY="${RAW_KEY:64:64}"
    RAW_KEY=""

    if [[ "$ALGO" == "aes-256-gcm" ]]; then
      # GCM: AAD verification is built into decryption — no separate pre-check needed.
      # Any tampering of header fields or ciphertext causes InvalidTag during decrypt.
      need python3 "sudo pacman -S python"
      python3 -c "from cryptography.hazmat.primitives.ciphers.aead import AESGCM" 2>/dev/null \
        || { err "python3-cryptography required: pip install cryptography --break-system-packages"; exit 1; }
      info "AES-256-GCM — header fields bound via AAD, verified during decryption"
    else
      [[ -z "$STORED_HMAC" ]] && {
        err "AUTH=yes but HMAC field missing — refusing to decrypt"; exit 1; }

      # Reconstruct the pre-HMAC header (strip HMAC= line that was appended last)
      HDR_NO_HMAC=$(printf '%s\n' "$HDR" | grep -v '^HMAC=')

      info "Verifying HMAC-SHA256 over all header fields + ciphertext ..."
      PAYLOAD_OFFSET=$(( 8 + HDR_LEN ))
      COMPUTED_HMAC=$(
        { printf '%s\n' "$HDR_NO_HMAC"
          dd if="$INPUT" bs=1 skip="$PAYLOAD_OFFSET" 2>/dev/null
        } | openssl dgst -sha256 -mac HMAC -macopt "hexkey:${HMAC_KEY}" \
          | awk '{print $NF}'
      )

      if [[ "$COMPUTED_HMAC" == "$STORED_HMAC" ]]; then
        ok "HMAC verified — every field + ciphertext authentic and untampered"
      else
        err "HMAC VERIFICATION FAILED"
        err "A header field or the ciphertext was modified, or the password is wrong."
        err "Refusing to decrypt."
        exit 1
      fi
    fi
  fi

  SHM_TMP="$(mktemp -d /dev/shm/vault.XXXXXX)"
  chmod 700 "$SHM_TMP"
  ORIG_CWD="$(pwd)"
  STAGE="${SHM_TMP}/stage"; mkdir -p "$STAGE"

  # ══════════════════════════════════════════════════════════════════════════
  step "1 / 2  Stream → Decrypt | Decompress | Extract"
  # ══════════════════════════════════════════════════════════════════════════
  # The pipeline streams from vault on disk through decrypt and decompress
  # directly into the staging dir — no intermediate decrypted file in shm.
  # Staging dir holds extracted files (same as final size), moved to CWD next.

  PAYLOAD_OFFSET=$(( 8 + HDR_LEN ))

  case "$METHOD" in
    vault)
      if [[ "${ALGO:-none}" == "none" ]]; then
        # Plain vault — just decompress
        if [[ "$HAS_TAR" == true ]]; then
          case "$COMP" in
            none)   dd if="$INPUT" bs=4096 iflag=skip_bytes skip="$PAYLOAD_OFFSET" 2>/dev/null \
                      | tar -xf - -C "$STAGE" 2>/dev/null ;;
            gzip)   dd if="$INPUT" bs=4096 iflag=skip_bytes skip="$PAYLOAD_OFFSET" 2>/dev/null \
                      | gunzip | tar -xf - -C "$STAGE" 2>/dev/null ;;
            bzip2)  dd if="$INPUT" bs=4096 iflag=skip_bytes skip="$PAYLOAD_OFFSET" 2>/dev/null \
                      | bunzip2 | tar -xf - -C "$STAGE" 2>/dev/null ;;
            xz)     dd if="$INPUT" bs=4096 iflag=skip_bytes skip="$PAYLOAD_OFFSET" 2>/dev/null \
                      | unxz | tar -xf - -C "$STAGE" 2>/dev/null ;;
            zstd)   dd if="$INPUT" bs=4096 iflag=skip_bytes skip="$PAYLOAD_OFFSET" 2>/dev/null \
                      | zstd -d -q | tar -xf - -C "$STAGE" 2>/dev/null ;;
            lz4)    dd if="$INPUT" bs=4096 iflag=skip_bytes skip="$PAYLOAD_OFFSET" 2>/dev/null \
                      | lz4 -d -q | tar -xf - -C "$STAGE" 2>/dev/null ;;
            brotli) dd if="$INPUT" bs=4096 iflag=skip_bytes skip="$PAYLOAD_OFFSET" 2>/dev/null \
                      | brotli -d | tar -xf - -C "$STAGE" 2>/dev/null ;;
            lzo)    dd if="$INPUT" bs=4096 iflag=skip_bytes skip="$PAYLOAD_OFFSET" 2>/dev/null \
                      | lzop -d | tar -xf - -C "$STAGE" 2>/dev/null ;;
            *)      # 7z/zlib need temp file
                    TMP_PAY="${SHM_TMP}/p.tmp"
                    dd if="$INPUT" bs=4096 iflag=skip_bytes skip="$PAYLOAD_OFFSET" of="$TMP_PAY" 2>/dev/null
                    if [[ "$COMP" == "7z" ]]; then
                      7z e "-o${SHM_TMP}/7z_out" "$TMP_PAY" >/dev/null 2>&1
                      tar -xf "${SHM_TMP}/7z_out/data.tar" -C "$STAGE" 2>/dev/null
                    else
                      python3 -c "import sys,zlib; sys.stdout.buffer.write(zlib.decompress(sys.stdin.buffer.read()))" \
                        < "$TMP_PAY" | tar -xf - -C "$STAGE" 2>/dev/null
                    fi
                    shred -uz "$TMP_PAY" 2>/dev/null ;;
          esac
        else
          # No tar — single raw file
          dd if="$INPUT" bs=4096 iflag=skip_bytes skip="$PAYLOAD_OFFSET" 2>/dev/null \
            > "${STAGE}/${ORIG_NAME}"
        fi

      else
        # Encrypted vault — stream: decrypt | decompress | extract
        if [[ "$HAS_TAR" == true ]]; then
          # Pre-scan: dry-run tar -tf before extraction to catch path traversal.
          # GCM vaults skip prescan — the auth tag provides a stronger guarantee
          # and GCM decryption requires python (can't use openssl enc for prescan).
          if [[ "$ALGO" != "aes-256-gcm" ]]; then
            info "Pre-scanning archive for path traversal..."
            _dec_stream() { dd if="$INPUT" bs=4096 iflag=skip_bytes skip="$PAYLOAD_OFFSET" 2>/dev/null | openssl enc -d "-${ALGO}" -K "$ENC_KEY" -iv "$IV" -nosalt 2>/dev/null; }
            case "$COMP" in
              none)   prescan_tar "_dec_stream" ;;
              gzip)   prescan_tar "_dec_stream | gunzip" ;;
              bzip2)  prescan_tar "_dec_stream | bunzip2" ;;
              xz)     prescan_tar "_dec_stream | unxz" ;;
              zstd)   prescan_tar "_dec_stream | zstd -d -q" ;;
              lz4)    prescan_tar "_dec_stream | lz4 -d -q" ;;
              brotli) prescan_tar "_dec_stream | brotli -d" ;;
              lzo)    prescan_tar "_dec_stream | lzop -d" ;;
              7z|zlib) : ;; # handled via TMP_DEC — check_tar_safety called after decompression
            esac
            ok "Pre-scan clean"
          else
            ok "Pre-scan skipped  (GCM auth tag verifies integrity natively)"
          fi

          # Decrypt helper — uses python for GCM, openssl for others
          # Decrypt helper: writes payload to shm temp, pipes through GCM/openssl
          _VAULT_PAY="${SHM_TMP}/vpay.bin"
          dd if="$INPUT" bs=4096 iflag=skip_bytes skip="$PAYLOAD_OFFSET" of="$_VAULT_PAY" 2>/dev/null
          _vault_decrypt() {
            if [[ "$ALGO" == "aes-256-gcm" ]]; then
              local _aad="VAULTV1|${LABEL:-$ALGO}|${COMP}|${FTYPE}|${ORIG_NAME}|${KDF_SALT}|${IV}"
              VAULT_KEY="$ENC_KEY" VAULT_NONCE="$IV" VAULT_AAD="$_aad" \
              python3 -c "
import sys, os
from cryptography.hazmat.primitives.ciphers.aead import AESGCM
key   = bytes.fromhex(os.environ['VAULT_KEY'])
nonce = bytes.fromhex(os.environ['VAULT_NONCE'])
aad   = os.environ['VAULT_AAD'].encode()
ct    = open(sys.argv[1],'rb').read()
try:
    pt = AESGCM(key).decrypt(nonce, ct, aad)
    sys.stdout.buffer.write(pt)
except Exception as e:
    sys.stderr.write('GCM auth failed: ' + str(e) + chr(10))
    sys.exit(1)
" "$_VAULT_PAY" 2>/dev/null
            else
              openssl enc -d "-${ALGO}" -K "$ENC_KEY" -iv "$IV" -nosalt \
                -in "$_VAULT_PAY" 2>/dev/null
            fi
          }


          case "$COMP" in
            none)   _vault_decrypt | tar -xf - -C "$STAGE" 2>/dev/null ;;
            gzip)   _vault_decrypt | gunzip  | tar -xf - -C "$STAGE" 2>/dev/null ;;
            bzip2)  _vault_decrypt | bunzip2 | tar -xf - -C "$STAGE" 2>/dev/null ;;
            xz)     _vault_decrypt | unxz    | tar -xf - -C "$STAGE" 2>/dev/null ;;
            zstd)   _vault_decrypt | zstd -d -q | tar -xf - -C "$STAGE" 2>/dev/null ;;
            lz4)    _vault_decrypt | lz4 -d -q  | tar -xf - -C "$STAGE" 2>/dev/null ;;
            brotli) _vault_decrypt | brotli -d  | tar -xf - -C "$STAGE" 2>/dev/null ;;
            lzo)    _vault_decrypt | lzop -d    | tar -xf - -C "$STAGE" 2>/dev/null ;;
            7z|zlib)
              # These need a temp file due to random-access requirements
              TMP_DEC="${SHM_TMP}/dec.tmp"; touch "$TMP_DEC" && chmod 600 "$TMP_DEC"
              dd if="$INPUT" bs=4096 iflag=skip_bytes skip="$PAYLOAD_OFFSET" 2>/dev/null \
                | openssl enc -d "-${ALGO}" -K "$ENC_KEY" -iv "$IV" -nosalt \
                  -out "$TMP_DEC" 2>/dev/null
              if [[ "$COMP" == "7z" ]]; then
                7z e "-o${SHM_TMP}/7z_out" "$TMP_DEC" >/dev/null 2>&1
                check_tar_safety "${SHM_TMP}/7z_out/data.tar"
                tar -xf "${SHM_TMP}/7z_out/data.tar" -C "$STAGE" 2>/dev/null
              else
                DECOPTED="${SHM_TMP}/decomp.tar"
                python3 -c "import sys,zlib; sys.stdout.buffer.write(zlib.decompress(sys.stdin.buffer.read()))" \
                  < "$TMP_DEC" > "$DECOPTED"
                check_tar_safety "$DECOPTED"
                tar -xf "$DECOPTED" -C "$STAGE" 2>/dev/null
                shred -uz "$DECOPTED" 2>/dev/null
              fi
              shred -uz "$TMP_DEC" 2>/dev/null ;;
          esac
        else
          # No tar — single file, no compression
          dd if="$INPUT" bs=4096 iflag=skip_bytes skip="$PAYLOAD_OFFSET" 2>/dev/null \
            | openssl enc -d "-${ALGO}" -K "$ENC_KEY" -iv "$IV" -nosalt 2>/dev/null \
            > "${STAGE}/${ORIG_NAME}"
        fi

        # Check pipeline succeeded
        [[ -e "${STAGE}/${ORIG_NAME}" || -n "$(ls -A "$STAGE" 2>/dev/null)" ]] \
          || { err "Decryption pipeline failed — wrong password or corrupted vault"; exit 1; }
      fi
      ;;

    age)
      echo
      if [[ "$HAS_TAR" == true ]]; then
        case "$COMP" in
          none)   age -d "$INPUT" 2>/dev/null | tar -xf - -C "$STAGE" 2>/dev/null ;;
          gzip)   age -d "$INPUT" 2>/dev/null | gunzip | tar -xf - -C "$STAGE" 2>/dev/null ;;
          bzip2)  age -d "$INPUT" 2>/dev/null | bunzip2 | tar -xf - -C "$STAGE" 2>/dev/null ;;
          xz)     age -d "$INPUT" 2>/dev/null | unxz | tar -xf - -C "$STAGE" 2>/dev/null ;;
          zstd)   age -d "$INPUT" 2>/dev/null | zstd -d -q | tar -xf - -C "$STAGE" 2>/dev/null ;;
          lz4)    age -d "$INPUT" 2>/dev/null | lz4 -d -q | tar -xf - -C "$STAGE" 2>/dev/null ;;
          brotli) age -d "$INPUT" 2>/dev/null | brotli -d | tar -xf - -C "$STAGE" 2>/dev/null ;;
          lzo)    age -d "$INPUT" 2>/dev/null | lzop -d | tar -xf - -C "$STAGE" 2>/dev/null ;;
          *)      TMP_DEC="${SHM_TMP}/dec.tmp"
                  age -d -o "$TMP_DEC" "$INPUT" 2>/dev/null \
                    || { echo; err "age decryption failed"; exit 1; }
                  if [[ "$COMP" == "7z" ]]; then
                    7z e "-o${SHM_TMP}/7z_out" "$TMP_DEC" >/dev/null 2>&1
                    tar -xf "${SHM_TMP}/7z_out/data.tar" -C "$STAGE" 2>/dev/null
                  else
                    python3 -c "import sys,zlib; sys.stdout.buffer.write(zlib.decompress(sys.stdin.buffer.read()))" \
                      < "$TMP_DEC" | tar -xf - -C "$STAGE" 2>/dev/null
                  fi
                  shred -uz "$TMP_DEC" 2>/dev/null ;;
        esac
      else
        age -d -o "${STAGE}/${ORIG_NAME}" "$INPUT" 2>/dev/null \
          || { echo; err "age decryption failed"; exit 1; }
      fi
      echo
      ;;

    gpg)
      if [[ "$HAS_TAR" == true ]]; then
        case "$COMP" in
          none)   printf '%s' "$PASSWD" | gpg --batch --passphrase-fd 0 --pinentry-mode loopback \
                    --no-symkey-cache -d "$INPUT" 2>/dev/null | tar -xf - -C "$STAGE" 2>/dev/null ;;
          gzip)   printf '%s' "$PASSWD" | gpg --batch --passphrase-fd 0 --pinentry-mode loopback \
                    --no-symkey-cache -d "$INPUT" 2>/dev/null | gunzip | tar -xf - -C "$STAGE" 2>/dev/null ;;
          bzip2)  printf '%s' "$PASSWD" | gpg --batch --passphrase-fd 0 --pinentry-mode loopback \
                    --no-symkey-cache -d "$INPUT" 2>/dev/null | bunzip2 | tar -xf - -C "$STAGE" 2>/dev/null ;;
          xz)     printf '%s' "$PASSWD" | gpg --batch --passphrase-fd 0 --pinentry-mode loopback \
                    --no-symkey-cache -d "$INPUT" 2>/dev/null | unxz | tar -xf - -C "$STAGE" 2>/dev/null ;;
          zstd)   printf '%s' "$PASSWD" | gpg --batch --passphrase-fd 0 --pinentry-mode loopback \
                    --no-symkey-cache -d "$INPUT" 2>/dev/null | zstd -d -q | tar -xf - -C "$STAGE" 2>/dev/null ;;
          lz4)    printf '%s' "$PASSWD" | gpg --batch --passphrase-fd 0 --pinentry-mode loopback \
                    --no-symkey-cache -d "$INPUT" 2>/dev/null | lz4 -d -q | tar -xf - -C "$STAGE" 2>/dev/null ;;
          brotli) printf '%s' "$PASSWD" | gpg --batch --passphrase-fd 0 --pinentry-mode loopback \
                    --no-symkey-cache -d "$INPUT" 2>/dev/null | brotli -d | tar -xf - -C "$STAGE" 2>/dev/null ;;
          lzo)    printf '%s' "$PASSWD" | gpg --batch --passphrase-fd 0 --pinentry-mode loopback \
                    --no-symkey-cache -d "$INPUT" 2>/dev/null | lzop -d | tar -xf - -C "$STAGE" 2>/dev/null ;;
          *)      TMP_DEC="${SHM_TMP}/dec.tmp"
                  printf '%s' "$PASSWD" | gpg --batch --passphrase-fd 0 --pinentry-mode loopback \
                    --no-symkey-cache -o "$TMP_DEC" -d "$INPUT" 2>/dev/null \
                    || { err "GPG decryption failed"; exit 1; }
                  if [[ "$COMP" == "7z" ]]; then
                    7z e "-o${SHM_TMP}/7z_out" "$TMP_DEC" >/dev/null 2>&1
                    tar -xf "${SHM_TMP}/7z_out/data.tar" -C "$STAGE" 2>/dev/null
                  else
                    python3 -c "import sys,zlib; sys.stdout.buffer.write(zlib.decompress(sys.stdin.buffer.read()))" \
                      < "$TMP_DEC" | tar -xf - -C "$STAGE" 2>/dev/null
                  fi
                  shred -uz "$TMP_DEC" 2>/dev/null ;;
        esac
      else
        printf '%s' "$PASSWD" | gpg --batch --passphrase-fd 0 --pinentry-mode loopback \
          --no-symkey-cache -o "${STAGE}/${ORIG_NAME}" -d "$INPUT" 2>/dev/null \
          || { err "GPG decryption failed"; exit 1; }
      fi
      ;;
  esac

  # Verify something actually landed in staging
  [[ -n "$(ls -A "$STAGE" 2>/dev/null)" ]] \
    || { err "Decryption or extraction produced no output"; exit 1; }
  ok "decrypted + extracted to staging  ($(du -sh "$STAGE" | cut -f1))"

  # ══════════════════════════════════════════════════════════════════════════
  step "2 / 2  Move to CWD"
  # ══════════════════════════════════════════════════════════════════════════
  if [[ "$HAS_TAR" == true ]]; then
    scan_stage_safety "$STAGE"
  fi

  OUT_PATH="${ORIG_CWD}/${ORIG_NAME}"
  if [[ -e "$OUT_PATH" ]]; then
    OUT_PATH="${ORIG_CWD}/${ORIG_NAME}_restored_$(date +%s)"
    warn "Path exists — saving as: $(basename "$OUT_PATH")"
  fi

  EXPECTED="${STAGE}/${ORIG_NAME}"
  if [[ -e "$EXPECTED" ]]; then
    mv "$EXPECTED" "$OUT_PATH"
  else
    ITEMS=( "${STAGE}"/* )
    if   (( ${#ITEMS[@]} == 1 )); then mv "${ITEMS[0]}" "$OUT_PATH"
    elif (( ${#ITEMS[@]} >  1 )); then mkdir -p "$OUT_PATH"; mv "${STAGE}"/* "$OUT_PATH/"
    else err "Staging directory is empty"; exit 1
    fi
  fi

  ok "moved to CWD  →  ${BLUE}${BOLD}${OUT_PATH}${NC}"

  sep
  echo -e "${SAPPHIRE}${BOLD}  ⬡  Done${NC}"
  lbl "  restored   :  " "$(du -sh "$OUT_PATH" 2>/dev/null | cut -f1)"
  lbl "  location   :  " "$OUT_PATH"
  lbl "  temp store :  " "/dev/shm  (RAM, shredded on exit)"
  echo
  echo -e "${GREEN}${BOLD}  🔓  Unsealed.${NC}"
  echo
}

main "$@"
