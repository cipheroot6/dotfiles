#!/usr/bin/env bash
# =============================================================================
#  enc  v5.2 — encrypt any file or folder
#  Usage : enc <file|directory>
#
#  MEMORY SAFETY:
#    All intermediate data lives exclusively in /dev/shm (RAM-backed tmpfs).
#    Nothing touches /tmp or any disk path during processing.
#    Temp dir is shredded (zeroed) before removal on exit, interrupt, or error.
#    The pipeline streams  tar | compress | openssl  without writing a
#    decompressed or unencrypted intermediate file — only one ciphertext file
#    ever exists in /dev/shm at a time.
#    Hard limit: aborts if estimated peak shm usage would exceed 100 MB.
#
#  VAULT FORMAT (.vault):
#    [8 ASCII hex = header byte length][plaintext header][ciphertext]
#    HMAC covers: all header fields (minus the HMAC= line itself) || ciphertext
#
#  KDF: Argon2id  t=3, m=2^14 KiB (16 MiB), p=4 → 64 bytes
#    RAW_KEY hex [0 –63]  = cipher key   (bytes 0–31, or 0–15 for 128-bit)
#    RAW_KEY hex [64–127] = HMAC key     (hex offset 64 = byte offset 32, 32 bytes)
# =============================================================================

set -uo pipefail

# ── Catppuccin Mocha ──────────────────────────────────────────────────────────
RED='\033[38;2;243;139;168m';    GREEN='\033[38;2;166;227;161m'
YELLOW='\033[38;2;249;226;175m'; BLUE='\033[38;2;137;180;250m'
MAUVE='\033[38;2;203;166;247m';  PEACH='\033[38;2;250;179;135m'
TEAL='\033[38;2;148;226;213m';   LAVENDER='\033[38;2;180;190;254m'
SAPPHIRE='\033[38;2;116;199;236m'
TEXT='\033[38;2;205;214;244m';   SUBTEXT='\033[38;2;166;173;200m'
BOLD='\033[1m'; DIM='\033[2m'; NC='\033[0m'

ok()   { echo -e "${GREEN}  ✓  ${*}${NC}"; }
err()  { echo -e "${RED}  ✗  ${*}${NC}" >&2; }
warn() { echo -e "${YELLOW}  ⚠  ${*}${NC}"; }
info() { echo -e "${TEAL}  →  ${*}${NC}"; }
step() { echo -e "\n${MAUVE}${BOLD}  ══  ${*}${NC}"; }
lbl()  { echo -e "${SUBTEXT}  ${1}${TEXT}${2:-}${NC}"; }
sep()  { echo -e "${SUBTEXT}${DIM}  ──────────────────────────────────────────${NC}"; }

banner() {
  local target="$1" mode="$2"
  local disp="$target"
  (( ${#disp} > 44 )) && disp="…${target: -43}"
  local inner="  vault ${mode}  v5.2  ·  ${disp}  "
  local w=${#inner} bar="" i
  for (( i=0; i<w; i++ )); do bar+="═"; done
  echo
  echo -e "${MAUVE}${BOLD}  ╔${bar}╗${NC}"
  echo -e "${MAUVE}${BOLD}  ║${inner}║${NC}"
  echo -e "${MAUVE}${BOLD}  ╚${bar}╝${NC}"
  echo
}

section() {
  local s_lbl="$1" line="" fill i
  fill=$(( 68 - ${#s_lbl} - 6 ))
  for (( i=0; i<fill; i++ )); do line+="─"; done
  echo -e "\n  ${SUBTEXT}${DIM}──  ${NC}${LAVENDER}${BOLD}${s_lbl}${NC}  ${SUBTEXT}${DIM}${line}${NC}\n"
}

menu_item() {
  local flag="$1" num="$2" name="$3" desc="$4" col
  case "$flag" in
    ★) col="$GREEN"  ;;
    ⚠) col="$YELLOW" ;;
    *) col="$NC"     ;;
  esac
  printf "    ${col}%s${NC}  ${SUBTEXT}%2d.${NC}  ${TEXT}%-36s${SUBTEXT}%s${NC}\n" \
    "$flag" "$num" "$name" "$desc"
}
menu_sep() { echo -e "    ${SUBTEXT}${DIM}── $*${NC}"; }

prompt_choice() {
  local max="$1" default="$2"
  while true; do
    printf "\n  ${PEACH}›  ${NC}${SUBTEXT}[default: ${default}]${NC}  "
    read -r choice
    [[ -z "$choice" ]] && choice="$default"
    if [[ "$choice" =~ ^[0-9]+$ ]] && (( choice >= 1 && choice <= max )); then
      CHOICE="$choice"; return 0
    fi
    warn "Enter a number between 1 and ${max}"
  done
}

pw_strength() {
  local pw="$1" score=0 len=0; len=${#pw}
  (( len >= 8  )) && (( score++ ))
  (( len >= 12 )) && (( score++ ))
  (( len >= 16 )) && (( score++ ))
  (( len >= 20 )) && (( score++ ))
  [[ "$pw" =~ [A-Z] ]]        && (( score++ ))
  [[ "$pw" =~ [a-z] ]]        && (( score++ ))
  [[ "$pw" =~ [0-9] ]]        && (( score++ ))
  [[ "$pw" =~ [^a-zA-Z0-9] ]] && (( score++ ))
  local filled=$(( score * 10 / 8 )); (( filled > 10 )) && filled=10
  local empty=$(( 10 - filled )) f="" e="" i
  for (( i=0; i<filled; i++ )); do f+="█"; done
  for (( i=0; i<empty;  i++ )); do e+="░"; done
  local col lbl
  if   (( score <= 2 )); then col="$RED";    lbl="weak"
  elif (( score <= 3 )); then col="$YELLOW"; lbl="fair"
  elif (( score <= 5 )); then col="$PEACH";  lbl="good"
  elif (( score <= 6 )); then col="$GREEN";  lbl="strong"
  else                        col="$GREEN";  lbl="excellent"
  fi
  printf "${col}%s${SUBTEXT}%s${NC}  ${col}%s${NC}" "$f" "$e" "$lbl"
}

need() { command -v "$1" &>/dev/null || { err "'$1' not installed.  $2"; exit 1; }; }

# ── /dev/shm guard ────────────────────────────────────────────────────────────
check_shm() {
  [[ -d /dev/shm && -w /dev/shm ]] || {
    err "/dev/shm is not available or not writable on this system"
    err "Cannot proceed — no safe in-memory workspace"
    exit 1
  }
  # Confirm it is actually tmpfs (RAM-backed)
  local fstype
  fstype=$(stat -f -c '%T' /dev/shm 2>/dev/null)
  [[ "$fstype" == "tmpfs" ]] || warn "/dev/shm reports fs type '${fstype}', expected tmpfs"
}

# ── Estimate peak /dev/shm bytes needed for a given input + compression ───────
# Returns estimate in bytes via stdout.
# Pipeline: tar | compress | enc → only ONE ciphertext file in shm at a time.
estimate_shm_bytes() {
  local input_bytes="$1" comp="$2"
  local tar_bytes=$(( input_bytes * 105 / 100 ))   # ~5% tar overhead
  local ratio
  case "$comp" in
    gzip|zstd|bzip2|xz) ratio=60 ;;   # ~40% reduction typical
    lz4|lzo|zlib)        ratio=75 ;;   # ~25% reduction
    brotli)              ratio=55 ;;   # ~45% reduction (text)
    7z)                  ratio=50 ;;   # ~50% reduction
    none)                ratio=100 ;;
    *)                   ratio=100 ;;
  esac
  echo $(( tar_bytes * ratio / 100 ))
}

# ── Shred all regular files in VAULT_TMP, then remove ────────────────────────
SHM_TMP=""
cleanup() {
  [[ -z "$SHM_TMP" || ! -d "$SHM_TMP" ]] && return
  # Zero every regular file before removal — belt-and-suspenders for RAM
  find "$SHM_TMP" -type f -exec shred -uz {} \; 2>/dev/null || true
  rm -rf "$SHM_TMP"
}
trap cleanup EXIT INT TERM

# ── Argon2id KDF ──────────────────────────────────────────────────────────────
# Arch: sudo pacman -S argon2
# -m N means 2^N KiB   (-m 14 = 16 MiB)
# Sets global $RAW_KEY to 128 hex chars (64 bytes)
derive_key() {
  local passwd="$1" salt="$2" t="$3" m="$4" p="$5"
  RAW_KEY=$(printf '%s' "$passwd" \
    | argon2 "$salt" -id -t "$t" -m "$m" -p "$p" -l 64 -r 2>/dev/null \
    | tr -d '[:space:]')
  [[ ${#RAW_KEY} -eq 128 ]] || {
    err "Argon2id failed (expected 128 hex chars, got ${#RAW_KEY})"
    err "Install: sudo pacman -S argon2"
    exit 1
  }
}

# =============================================================================
main() {
  need openssl "sudo pacman -S openssl"
  need tar     "sudo pacman -S tar"
  need shred   "sudo pacman -S coreutils"
  check_shm

  [[ $# -lt 1 ]] && { err "Usage: enc <file|directory>"; exit 1; }
  INPUT="${1%/}"
  [[ ! -e "$INPUT" ]] && { err "Path not found: $INPUT"; exit 1; }

  ABS_INPUT="$(realpath "$INPUT")"
  PARENT_DIR="$(dirname "$ABS_INPUT")"
  ORIG_NAME="$(basename "$ABS_INPUT")"
  [[ -d "$ABS_INPUT" ]] && FTYPE="dir" || FTYPE="file"

  banner "$ABS_INPUT" "enc"

  # ──────────────────────────────────────────────────────────────────────────
  section "Encryption"
  menu_item "★"  1 "AES-256-GCM"                "best default, native AEAD  (requires python3-cryptography)"
  menu_item "★"  2 "AES-256-CTR + HMAC-SHA256"  "recommended, no extra deps"
  menu_item "★"  3 "ChaCha20   + HMAC-SHA256"   "best without AES-NI hardware"
  menu_item " "  4 "AES-128-CTR + HMAC-SHA256"  "faster, slightly weaker key"
  menu_item " "  5 "age"                         "modern, ChaCha20-Poly1305"
  menu_item " "  6 "none"                         "no encryption  ⚠  plain data"
  prompt_choice 6 1

  METHOD="openssl"; CIPHER_ALG=""; AUTH="no"; KEY_LEN=64; LABEL=""
  case "$CHOICE" in
    1) CIPHER_ALG="aes-256-gcm"; AUTH="yes"; KEY_LEN=64; LABEL="AES-256-GCM"              ;;
    2) CIPHER_ALG="aes-256-ctr"; AUTH="yes"; KEY_LEN=64; LABEL="AES-256-CTR+HMAC-SHA256"  ;;
    3) CIPHER_ALG="chacha20";    AUTH="yes"; KEY_LEN=64; LABEL="ChaCha20+HMAC-SHA256"      ;;
    4) CIPHER_ALG="aes-128-ctr"; AUTH="yes"; KEY_LEN=32; LABEL="AES-128-CTR+HMAC-SHA256"  ;;
    5) METHOD="age";                                     LABEL="age"                       ;;
    6) METHOD="none";                                    LABEL="none"                      ;;
  esac

  case "$METHOD" in
    openssl) need argon2 "sudo pacman -S argon2" ;;
    age)     need age    "sudo pacman -S age"     ;;
  esac

  if [[ "$METHOD" == "none" ]]; then
    echo; warn "No encryption — output will be PLAIN DATA."
    printf "${PEACH}  Continue? [y/N]  ${NC}"; read -r ans
    [[ "$ans" =~ ^[yY]$ ]] || { info "Aborted."; exit 0; }
  elif [[ "$METHOD" == "openssl" && "$AUTH" == "no" ]]; then
    echo; warn "Unauthenticated mode — ciphertext tampering will not be detected."
  fi

  # ──────────────────────────────────────────────────────────────────────────
  section "Compression"
  menu_item "★"  1 "zstd"           "recommended  ·  fast + best ratio"
  menu_item " "  2 "gzip"           "universal compatibility"
  menu_item " "  3 "lz4"            "speed-first"
  menu_item " "  4 "bzip2"          "better ratio, slower"
  menu_item " "  5 "xz"             "best ratio, slowest"
  menu_item " "  6 "brotli"         "optimised for text"
  menu_item " "  7 "7z / lzma"      "requires p7zip"
  menu_item " "  8 "zlib / deflate" "standard deflate"
  menu_item " "  9 "lzop"           "very fast, low ratio"
  menu_item " " 10 "none"           "skip compression"
  prompt_choice 10 1

  case "$CHOICE" in
    1) COMP="zstd";   COMP_EXT=".zst"  ;;
    2) COMP="gzip";   COMP_EXT=".gz"   ;;
    3) COMP="lz4";    COMP_EXT=".lz4"  ;;
    4) COMP="bzip2";  COMP_EXT=".bz2"  ;;
    5) COMP="xz";     COMP_EXT=".xz"   ;;
    6) COMP="brotli"; COMP_EXT=".br"   ;;
    7) COMP="7z";     COMP_EXT=".7z"   ;;
    8) COMP="zlib";   COMP_EXT=".zlib" ;;
    9) COMP="lzo";    COMP_EXT=".lzo"  ;;
   10) COMP="none";   COMP_EXT=""      ;;
  esac

  case "$COMP" in
    zstd)   need zstd    "sudo pacman -S zstd"   ;;
    lz4)    need lz4     "sudo pacman -S lz4"    ;;
    brotli) need brotli  "sudo pacman -S brotli" ;;
    lzo)    need lzop    "sudo pacman -S lzop"   ;;
    7z)     need 7z      "sudo pacman -S p7zip"  ;;
    zlib)   need python3 "sudo pacman -S python" ;;
  esac

  # ── Size and memory check ─────────────────────────────────────────────────
  INPUT_BYTES=$(du -sb "$ABS_INPUT" 2>/dev/null | cut -f1)
  SHM_NEEDED=$(estimate_shm_bytes "$INPUT_BYTES" "$COMP")
  SHM_LIMIT=$(( 100 * 1024 * 1024 ))   # 100 MiB hard limit
  SHM_FREE=$(( $(df --output=avail /dev/shm | tail -1) * 1024 ))

  if (( SHM_NEEDED > SHM_LIMIT )); then
    echo
    err "Estimated peak memory usage: $(( SHM_NEEDED / 1024 / 1024 )) MiB exceeds 100 MiB limit."
    err "Input: $(( INPUT_BYTES / 1024 / 1024 )) MiB   Compression: ${COMP}"
    err "To process larger files, split them first or use a compression with a higher ratio."
    exit 1
  fi

  if (( SHM_NEEDED > SHM_FREE )); then
    err "Not enough /dev/shm space: need ~$(( SHM_NEEDED / 1024 / 1024 )) MiB, have $(( SHM_FREE / 1024 / 1024 )) MiB"
    exit 1
  fi

  # ──────────────────────────────────────────────────────────────────────────
  section "Password"
  PASSWD=""
  if [[ "$METHOD" != "age" && "$METHOD" != "none" ]]; then
    while true; do
      printf "  ${LAVENDER}${BOLD}Password :  ${NC}"; read -rs PASSWD; echo
      [[ -z "$PASSWD" ]] && { warn "Password cannot be empty"; echo; continue; }

      printf "  ${LAVENDER}${BOLD}Confirm  :  ${NC}"; read -rs P2; echo
      if [[ "$PASSWD" != "$P2" ]]; then
        warn "Passwords don't match — try again"; echo; continue
      fi

      echo -e "  ${SUBTEXT}Strength :  ${NC}$(pw_strength "$PASSWD")"
      echo
      break
    done; echo
  elif [[ "$METHOD" == "age" ]]; then
    info "age will prompt for passphrase during encryption"; echo
  fi

  # ── Option A: single file + no comp + age/gpg = skip tar ──────────────────
  USE_TAR=true
  if [[ "$FTYPE" == "file" && "$COMP" == "none" \
        && "$METHOD" == "age" ]]; then
    USE_TAR=false
  fi

  # ── Output filename ────────────────────────────────────────────────────────
  if [[ "$METHOD" == "openssl" || "$METHOD" == "none" ]]; then
    OUTPUT="${ORIG_NAME}.vault"
  elif [[ "$USE_TAR" == false ]]; then
    OUTPUT="${ORIG_NAME}.${METHOD}"
  elif [[ "$COMP" == "none" ]]; then
    OUTPUT="${ORIG_NAME}.tar.${METHOD}"
  else
    OUTPUT="${ORIG_NAME}.tar${COMP_EXT}.${METHOD}"
  fi

  if [[ -e "$OUTPUT" ]]; then
    TS=$(date +%s); EXT="${OUTPUT##*.}"
    OUTPUT="${OUTPUT%.*}_${TS}.${EXT}"
    warn "Output exists — saving as: $OUTPUT"
  fi

  # Create shm workspace — chmod 700 so other users can't read intermediate files
  SHM_TMP="$(mktemp -d /dev/shm/vault.XXXXXX)"
  chmod 700 "$SHM_TMP"

  KDF_T=3; KDF_M=14; KDF_P=4
  KDF_SALT=""; IV=""; ENC_KEY=""; HMAC_KEY=""; STORED_HMAC=""; INTEGRITY=""

  # ══════════════════════════════════════════════════════════════════════════
  step "1 / 3  Stream → Archive | Compress | Encrypt"
  # ══════════════════════════════════════════════════════════════════════════
  # The entire pipeline runs in one shot: tar | compress | openssl enc
  # Only ONE file ever sits in /dev/shm: the ciphertext.
  # No uncompressed tar file, no unencrypted compressed file — ever.

  CIPHER_FILE="${SHM_TMP}/payload.enc"
  touch "$CIPHER_FILE" && chmod 600 "$CIPHER_FILE"

  case "$METHOD" in
    none)
      # No encryption — just archive+compress into shm, compute SHA-256
      if [[ "$USE_TAR" == true ]]; then
        case "$COMP" in
          none)   tar -cf - -C "$PARENT_DIR" "$ORIG_NAME" 2>/dev/null > "$CIPHER_FILE" ;;
          gzip)   tar -cf - -C "$PARENT_DIR" "$ORIG_NAME" 2>/dev/null | gzip > "$CIPHER_FILE" ;;
          bzip2)  tar -cf - -C "$PARENT_DIR" "$ORIG_NAME" 2>/dev/null | bzip2 > "$CIPHER_FILE" ;;
          xz)     tar -cf - -C "$PARENT_DIR" "$ORIG_NAME" 2>/dev/null | xz -T0 > "$CIPHER_FILE" ;;
          zstd)   tar -cf - -C "$PARENT_DIR" "$ORIG_NAME" 2>/dev/null | zstd -T0 -q > "$CIPHER_FILE" ;;
          lz4)    tar -cf - -C "$PARENT_DIR" "$ORIG_NAME" 2>/dev/null | lz4 -q > "$CIPHER_FILE" ;;
          lzo)    tar -cf - -C "$PARENT_DIR" "$ORIG_NAME" 2>/dev/null | lzop > "$CIPHER_FILE" ;;
          brotli) tar -cf - -C "$PARENT_DIR" "$ORIG_NAME" 2>/dev/null | brotli > "$CIPHER_FILE" ;;
          7z)     tar -cf "${SHM_TMP}/d.tar" -C "$PARENT_DIR" "$ORIG_NAME" 2>/dev/null
                  7z a -t7z -mx=9 -mmt=on -so dummy "${SHM_TMP}/d.tar" > "$CIPHER_FILE" 2>/dev/null
                  shred -uz "${SHM_TMP}/d.tar" 2>/dev/null || rm -f "${SHM_TMP}/d.tar" ;;
          zlib)   tar -cf - -C "$PARENT_DIR" "$ORIG_NAME" 2>/dev/null \
                    | python3 -c "import sys,zlib; sys.stdout.buffer.write(zlib.compress(sys.stdin.buffer.read(),9))" \
                    > "$CIPHER_FILE" ;;
        esac
      else
        cp "$ABS_INPUT" "$CIPHER_FILE"
      fi
      INTEGRITY=$(sha256sum "$CIPHER_FILE" | awk '{print $1}')
      ok "archived+compressed  →  $(du -sh "$CIPHER_FILE" | cut -f1)  (no encryption)"
      ;;

    openssl)
      KDF_SALT=$(openssl rand -hex 16)
      # GCM uses 12-byte nonce; CTR/CBC use 16-byte IV
      if [[ "$CIPHER_ALG" == "aes-256-gcm" ]]; then
        IV=$(openssl rand -hex 12)   # 96-bit nonce for GCM
        need python3 "sudo pacman -S python"
        python3 -c "from cryptography.hazmat.primitives.ciphers.aead import AESGCM" 2>/dev/null           || { err "python3-cryptography not installed. Install: pip install cryptography --break-system-packages"; exit 1; }
      else
        IV=$(openssl rand -hex 16)   # 128-bit IV for CTR/CBC
      fi
      info "Argon2id  (t=${KDF_T}, m=2^${KDF_M} KiB = 16 MiB, p=${KDF_P}) ..."
      derive_key "$PASSWD" "$KDF_SALT" "$KDF_T" "$KDF_M" "$KDF_P"
      # RAW_KEY hex [0–63]   = cipher key  (bytes 0–31, or 0–15 for 128-bit)
      # RAW_KEY hex [64–127] = HMAC key    (hex offset 64 = byte offset 32, 32 bytes)
      ENC_KEY="${RAW_KEY:0:$KEY_LEN}"
      HMAC_KEY="${RAW_KEY:64:64}"
      RAW_KEY=""

      # Stream: tar | compress | openssl enc  → ciphertext only in shm

      # CIPHER_ALG already set above
      

      # Encrypt function: pipes compressed data through either openssl or python AES-256-GCM
      _do_encrypt() {
        local in_fd="/dev/stdin"
        if [[ "$CIPHER_ALG" == "aes-256-gcm" ]]; then
          # AES-256-GCM via python3 cryptography — native AEAD, no separate HMAC needed
          # AAD binds all header fields to the ciphertext
          local aad="VAULTV1|${LABEL}|${COMP}|${FTYPE}|${ORIG_NAME}|${KDF_SALT}|${IV}"
          VAULT_KEY="$ENC_KEY" VAULT_NONCE="$IV" VAULT_AAD="$aad"           python3 -c "
import sys, os
from cryptography.hazmat.primitives.ciphers.aead import AESGCM
key   = bytes.fromhex(os.environ['VAULT_KEY'])
nonce = bytes.fromhex(os.environ['VAULT_NONCE'])
aad   = os.environ['VAULT_AAD'].encode()
ct    = AESGCM(key).encrypt(nonce, sys.stdin.buffer.read(), aad)
sys.stdout.buffer.write(ct)
" > "$CIPHER_FILE" 2>/dev/null
        else
          openssl enc "-${CIPHER_ALG}" -K "$ENC_KEY" -iv "$IV" -nosalt             -out "$CIPHER_FILE" 2>/dev/null
        fi
      }

      _run_pipeline() {
        case "$COMP" in
          none)   tar -cf - -C "$PARENT_DIR" "$ORIG_NAME" 2>/dev/null | _do_encrypt ;;
          gzip)   tar -cf - -C "$PARENT_DIR" "$ORIG_NAME" 2>/dev/null | gzip   | _do_encrypt ;;
          bzip2)  tar -cf - -C "$PARENT_DIR" "$ORIG_NAME" 2>/dev/null | bzip2  | _do_encrypt ;;
          xz)     tar -cf - -C "$PARENT_DIR" "$ORIG_NAME" 2>/dev/null | xz -T0 | _do_encrypt ;;
          zstd)   tar -cf - -C "$PARENT_DIR" "$ORIG_NAME" 2>/dev/null | zstd -T0 -q | _do_encrypt ;;
          lz4)    tar -cf - -C "$PARENT_DIR" "$ORIG_NAME" 2>/dev/null | lz4 -q     | _do_encrypt ;;
          lzo)    tar -cf - -C "$PARENT_DIR" "$ORIG_NAME" 2>/dev/null | lzop       | _do_encrypt ;;
          brotli) tar -cf - -C "$PARENT_DIR" "$ORIG_NAME" 2>/dev/null | brotli     | _do_encrypt ;;
          7z)     tar -cf "${SHM_TMP}/d.tar" -C "$PARENT_DIR" "$ORIG_NAME" 2>/dev/null
                  7z a -t7z -mx=9 -mmt=on -so dummy "${SHM_TMP}/d.tar" 2>/dev/null | _do_encrypt
                  shred -uz "${SHM_TMP}/d.tar" 2>/dev/null || rm -f "${SHM_TMP}/d.tar" ;;
          zlib)   tar -cf - -C "$PARENT_DIR" "$ORIG_NAME" 2>/dev/null                     | python3 -c "import sys,zlib; sys.stdout.buffer.write(zlib.compress(sys.stdin.buffer.read(),9))"                     | _do_encrypt ;;
        esac
      }

      # For single file + no tar (Option A): pipe file directly
      if [[ "$USE_TAR" == false ]]; then
        case "$COMP" in
          none) _do_encrypt < "$ABS_INPUT" ;;
          *)    _run_pipeline ;;
        esac
      else
        _run_pipeline
      fi


      [[ -s "$CIPHER_FILE" ]] || { err "Pipeline produced empty ciphertext"; exit 1; }
      ok "streamed  →  $(du -sh "$CIPHER_FILE" | cut -f1)  (tar | ${COMP} | ${CIPHER_ALG})"
      ;;

    age)
      if [[ "$USE_TAR" == false ]]; then
        echo; age -p -o "$CIPHER_FILE" "$ABS_INPUT" || { err "age failed"; exit 1; }
      else
        case "$COMP" in
          none) tar -cf - -C "$PARENT_DIR" "$ORIG_NAME" 2>/dev/null | age -p -o "$CIPHER_FILE" ;;
          gzip) tar -cf - -C "$PARENT_DIR" "$ORIG_NAME" 2>/dev/null | gzip | age -p -o "$CIPHER_FILE" ;;
          *)    tar -cf "${SHM_TMP}/d.tar" -C "$PARENT_DIR" "$ORIG_NAME" 2>/dev/null
                age -p -o "$CIPHER_FILE" "${SHM_TMP}/d.tar"
                shred -uz "${SHM_TMP}/d.tar" 2>/dev/null || rm -f "${SHM_TMP}/d.tar" ;;
        esac
        echo
      fi
      ok "encrypted  (age, ChaCha20-Poly1305)"
      ;;
  esac

  # ══════════════════════════════════════════════════════════════════════════
  step "2 / 3  HMAC + Assemble"
  # ══════════════════════════════════════════════════════════════════════════
  if [[ "$METHOD" == "openssl" || "$METHOD" == "none" ]]; then
    HDR="${SHM_TMP}/header.txt"
    {
      echo "VAULTV1"
      echo "LABEL=${LABEL}"
      echo "ALGO=${CIPHER_ALG:-none}"
      echo "AUTH=${AUTH}"
      echo "COMP=${COMP}"
      echo "TYPE=${FTYPE}"
      echo "ORIG=${ORIG_NAME}"
      echo "TAR=${USE_TAR}"
      if [[ "$METHOD" == "openssl" ]]; then
        echo "KDF=argon2id"
        echo "KDF_SALT=${KDF_SALT}"
        echo "KDF_T=${KDF_T}"
        echo "KDF_M=${KDF_M}"
        echo "KDF_P=${KDF_P}"
        echo "KDF_L=64"
        echo "KEY_LEN=${KEY_LEN}"
        echo "IV=${IV}"
      else
        echo "INTEGRITY=${INTEGRITY}"
      fi
    } > "$HDR"

    if [[ "$METHOD" == "openssl" && "$AUTH" == "yes" ]]; then
      if [[ "$CIPHER_ALG" == "aes-256-gcm" ]]; then
        # AES-256-GCM binds header fields via AAD internally — no separate HMAC needed
        ok "GCM authentication tag embedded in ciphertext  (header bound via AAD)"
      else
        info "HMAC-SHA256 over all header fields + ciphertext ..."
        STORED_HMAC=$(
          { cat "$HDR"; cat "$CIPHER_FILE"; } \
          | openssl dgst -sha256 -mac HMAC -macopt "hexkey:${HMAC_KEY}" \
          | awk '{print $NF}'
        )
        [[ ${#STORED_HMAC} -eq 64 ]] || { err "HMAC computation failed"; exit 1; }
        echo "HMAC=${STORED_HMAC}" >> "$HDR"
        ok "HMAC computed  (covers all header fields + ciphertext)"
      fi
    fi

    HDR_LEN=$(wc -c < "$HDR")
    HDR_HEX=$(printf '%08x' "$HDR_LEN")
    { printf '%s' "$HDR_HEX"; cat "$HDR"; cat "$CIPHER_FILE"; } > "$OUTPUT"
  else
    cp "$CIPHER_FILE" "$OUTPUT"
  fi

  chmod 600 "$OUTPUT"

  # Shred ciphertext from shm immediately after vault is written
  shred -uz "$CIPHER_FILE" 2>/dev/null && ok "ciphertext shredded from /dev/shm"

  # ══════════════════════════════════════════════════════════════════════════
  step "3 / 3  Verify"
  # ══════════════════════════════════════════════════════════════════════════
  if [[ "$METHOD" == "openssl" && "$CIPHER_ALG" == "aes-256-gcm" ]]; then
    # GCM: trial-decrypt the on-disk payload to confirm the auth tag survived the write.
    DISK_HDR_HEX=$(dd if="$OUTPUT" bs=1 count=8 2>/dev/null)
    DISK_HDR_LEN=$(( 16#$DISK_HDR_HEX ))
    DISK_PAY="${SHM_TMP}/v_pay.bin"
    dd if="$OUTPUT" bs=1 skip="$(( 8 + DISK_HDR_LEN ))" of="$DISK_PAY" 2>/dev/null
    GCM_AAD="VAULTV1|${LABEL}|${COMP}|${FTYPE}|${ORIG_NAME}|${KDF_SALT}|${IV}"
    VAULT_KEY="$ENC_KEY" VAULT_NONCE="$IV" VAULT_AAD="$GCM_AAD" \
    python3 -c "
import sys, os
from cryptography.hazmat.primitives.ciphers.aead import AESGCM
key   = bytes.fromhex(os.environ['VAULT_KEY'])
nonce = bytes.fromhex(os.environ['VAULT_NONCE'])
aad   = os.environ['VAULT_AAD'].encode()
ct    = open(sys.argv[1], 'rb').read()
try:
    AESGCM(key).decrypt(nonce, ct, aad)
except Exception as e:
    sys.stderr.write(str(e) + '\\n')
    sys.exit(1)
" "$DISK_PAY" 2>/dev/null
    GCM_RC=$?
    shred -uz "$DISK_PAY" 2>/dev/null || rm -f "$DISK_PAY"
    if (( GCM_RC == 0 )); then
      ok "GCM tag re-verified on disk  (vault integrity confirmed)"
    else
      err "GCM post-write verification failed — vault corrupt, deleting."
      rm -f "$OUTPUT"; exit 1
    fi

  elif [[ "$METHOD" == "openssl" && "$AUTH" == "yes" ]]; then
    DISK_HDR_HEX=$(dd if="$OUTPUT" bs=1 count=8 2>/dev/null)
    DISK_HDR_LEN=$(( 16#$DISK_HDR_HEX ))
    DISK_HDR="${SHM_TMP}/v_hdr.bin"; DISK_PAY="${SHM_TMP}/v_pay.bin"
    dd if="$OUTPUT" bs=1 skip=8                            count="$DISK_HDR_LEN" of="$DISK_HDR" 2>/dev/null
    dd if="$OUTPUT" bs=1 skip="$(( 8 + DISK_HDR_LEN ))"                         of="$DISK_PAY" 2>/dev/null
    HDR_NO_HMAC=$(grep -v '^HMAC=' "$DISK_HDR")
    VERIFY_HMAC=$(
      { printf '%s\n' "$HDR_NO_HMAC"; cat "$DISK_PAY"; } \
      | openssl dgst -sha256 -mac HMAC -macopt "hexkey:${HMAC_KEY}" \
      | awk '{print $NF}'
    )
    shred -uz "$DISK_HDR" "$DISK_PAY" 2>/dev/null || rm -f "$DISK_HDR" "$DISK_PAY"
    if [[ "$VERIFY_HMAC" == "$STORED_HMAC" ]]; then
      ok "HMAC re-verified on disk  (vault integrity confirmed)"
    else
      err "Post-write HMAC mismatch — vault corrupt, deleting."
      rm -f "$OUTPUT"; exit 1
    fi

  elif [[ "$METHOD" == "none" ]]; then
    DISK_HDR_HEX=$(dd if="$OUTPUT" bs=1 count=8 2>/dev/null)
    DISK_HDR_LEN=$(( 16#$DISK_HDR_HEX ))
    VCHECK="${SHM_TMP}/vcheck.bin"
    dd if="$OUTPUT" bs=1 skip="$(( 8 + DISK_HDR_LEN ))" of="$VCHECK" 2>/dev/null
    VI=$(sha256sum "$VCHECK" | awk '{print $1}')
    shred -uz "$VCHECK" 2>/dev/null || rm -f "$VCHECK"
    [[ "$VI" == "$INTEGRITY" ]] && ok "SHA-256 verified on disk" \
      || { err "SHA-256 mismatch — vault corrupt, deleting."; rm -f "$OUTPUT"; exit 1; }

  elif [[ "$METHOD" == "openssl" && "$AUTH" == "no" ]]; then
    warn "Unauthenticated mode — post-write integrity check skipped"
  else
    ok "Integrity managed internally by $METHOD"
  fi

  # ── Summary ────────────────────────────────────────────────────────────────
  FINGERPRINT=$(sha256sum "$OUTPUT" | awk '{print $1}')
  echo; sep
  echo -e "${SAPPHIRE}${BOLD}  ⬡  Summary${NC}"
  lbl "  input      :  " "$(du -sh "$ABS_INPUT" 2>/dev/null | cut -f1)  ($FTYPE)"
  lbl "  output     :  " "$(du -sh "$OUTPUT" 2>/dev/null | cut -f1)  →  ${BLUE}${BOLD}${OUTPUT}${NC}"
  lbl "  cipher     :  " "$LABEL"
  lbl "  compress   :  " "$COMP"
  if [[ "$METHOD" == "openssl" ]]; then
    lbl "  kdf        :  " "Argon2id  t=${KDF_T}, m=2^${KDF_M} KiB (16 MiB), p=${KDF_P}"
  else
    lbl "  kdf        :  " "n/a  (handled by ${LABEL:-$METHOD})"
  fi
  lbl "  hmac       :  " "${AUTH}"
  lbl "  tar wrap   :  " "$USE_TAR"
  lbl "  temp store :  " "/dev/shm  (RAM, shredded on exit)"
  lbl "  perms      :  " "600"
  lbl "  SHA-256    :  " "${SUBTEXT}${FINGERPRINT}${NC}"
  echo
  echo -e "${GREEN}${BOLD}  🔒  Sealed.${NC}"
  echo
}

main "$@"
