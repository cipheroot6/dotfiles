{
  "logo": {
    "type": "kitty-direct",
    "source": "~/.config/fastfetch/logo.png",   //if ur cant see this use terminals like ghostty or kitty 
    "width": 43,
    "height": 21,
    "padding": {
      "left": 2,
      "top": 1
    }
  },
  "display": {
    "separator": " 󰑃  "
  },
  "modules": [
    "break",
    {
      "type": "os",
      "key": " DISTRO",
      "keyColor": "magenta"
    },
    {
      "type": "kernel",
      "key": "│ ├",
      "keyColor": "magenta"
    },
    {
      "type": "packages",
      "key": "│ ├󰏖",
      "keyColor": "magenta"
    },
    {
      "type": "command",
      "key": "│ ├",
      "keyColor": "magenta",
      "text": "birth_install=$(stat -c %W /); current=$(date +%s); time_progression=$((current - birth_install)); days_difference=$((time_progression / 86400)); echo $days_difference days",
    },
    {
      "type": "shell",
      "key": "│ └",
      "keyColor": "magenta"
    },

    {
      "type": "wm",
      "key": " DE/WM",
      "keyColor": "magenta"
    },
    {
      "type": "wmtheme",
      "key": "│ ├󰉼",
      "keyColor": "magenta"
    },
    {
      "type": "icons",
      "key": "│ ├󰀻",
      "keyColor": "magenta"
    },
    {
      "type": "cursor",
      "key": "│ ├",
      "keyColor": "magenta"
    },
    {
      "type": "terminalfont",
      "key": "│ ├",
      "keyColor": "magenta"
    },
    {
      "type": "terminal",
      "key": "│ └",
      "keyColor": "magenta"
    },
    {
      "type": "host",
      "key": "󰌢 SYSTEM",
      "keyColor": "magenta"
    },
    {
      "type": "cpu",
      "key": "│ ├󰻠",
      "keyColor": "magenta"
    },
    {
      "type": "gpu",
      "key": "│ ├󰻑",
      "format": "{2}",
      "keyColor": "magenta"
    },
    {
      "type": "display",
      "key": "│ ├󰍹",
      "keyColor": "magenta",
      "compactType": "original-with-refresh-rate"
    },
    {
      "type": "memory",
      "key": "│ ├󰾆",
      "keyColor": "magenta"
    },
    {
      "type": "swap",
      "key": "│ ├󰓡",
      "keyColor": "magenta"
    },
    {
      "type": "disk",
      "key": "│ ├󰋊",
      "keyColor": "magenta"
    },
    {
      "type": "command",
      "key": "│ ├󰔏",
      "keyColor": "magenta",
      "text": "awk '{printf \"cpu temperature: %.1f°C\", $1/1000}' /sys/class/hwmon/hwmon6/temp1_input",
    },
    {
      "type": "uptime",
      "key": "│ ├󰅐",
      "keyColor": "magenta"
    },
    {
      "type": "sound",
      "key": " AUDIO",
      "format": "{2}",
      "keyColor": "magenta"
    },
    {
      "type": "player",
      "key": "│ ├󰥠",
      "keyColor": "magenta"
    },
    {
      "type": "media",
      "key": "│ └󰝚",
      "keyColor": "magenta"
    },
    "break"
  ]
}
